# Supabase Local Development Environment Variables
# Copy this file to .env.local and fill in with your local Supabase credentials

# Local Supabase API URL (default: http://localhost:54321)
SUPABASE_URL=http://localhost:54321

# Local Supabase Anon Key (use placeholder for public examples)
SUPABASE_ANON_KEY=YOUR_LOCAL_ANON_KEY_HERE

# Local Supabase Service Role Key (for admin operations - keep secure!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY_HERE

# JWT Secret (for local development)
JWT_SECRET=your-super-secret-jwt-token-change-this-in-production
